{
  "id": "playbook",
  "schema_version": 2,
  "version": 1,
  "identity": {
    "strategy": "id"
  },
  "on_missing": "create",
  "allow_create_folder": true,
  "root": {
    "type": "md",
    "own_folder": false,
    "plain_filename": true,
    "on_existing_title": "update_section",
    "frontmatter_defaults": {
      "type": "Playbook",
      "name": "",
      "solutions": [],
      "play": "",
      "status": "draft",
      "last_refreshed": "",
      "tags": [
        "kind/playbook"
      ]
    },
    "sections": [
      {
        "name": "Summary",
        "access": "machine_write"
      },
      {
        "name": "Who to target",
        "access": "machine_write"
      },
      {
        "name": "Solution path",
        "access": "machine_write"
      },
      {
        "name": "Discovery questions",
        "access": "machine_write"
      },
      {
        "name": "Value story",
        "access": "machine_write"
      },
      {
        "name": "Pitch sequence",
        "access": "machine_write"
      },
      {
        "name": "Sizing",
        "access": "machine_write"
      },
      {
        "name": "Objections",
        "access": "machine_write"
      },
      {
        "name": "Core42 angle",
        "access": "machine_write"
      },
      {
        "name": "Next steps",
        "access": "machine_write"
      },
      {
        "name": "Sources",
        "access": "machine_write"
      }
    ]
  }
}
